# Copy to .env locally; never commit the filled-in file.
EDGEDOCTOR_API_TOKEN=change-me
EDGEDOCTOR_MQTT_USER=edgedoctor
EDGEDOCTOR_MQTT_PASSWORD=change-me
EDGEDOCTOR_NTFY_URL=https://ntfy.sh
EDGEDOCTOR_NTFY_TOPIC=change-me
EDGEDOCTOR_NTFY_TOKEN=
EDGEDOCTOR_MQTT_CA=/absolute/path/to/ca.crt
EDGEDOCTOR_MQTT_HOST=127.0.0.1
EDGEDOCTOR_MQTT_PORT=8883
# Subscribe to every device under the site/device/events namespace.
EDGEDOCTOR_EVENTS_TOPIC=edgedoctor/+/+/#
EDGEDOCTOR_CLIENT_ID=edgedoctor-service
# Site segment used when publishing queued commands. It must match the site
# the device was provisioned with (`edmqtt config <site> ...`), otherwise the
# device never sees the command topic it subscribed to.
EDGEDOCTOR_SITE_ID=site_1
